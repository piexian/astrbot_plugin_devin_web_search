{
  "devin_session_token": {
    "type": "list",
    "description": "Devin 会话 Token",
    "hint": "/devin login 自动追加，或手动添加（devin token，需带 devin-session-token$ 前缀）",
    "secret": true,
    "default": []
  },
  "search_hosts": {
    "type": "list",
    "description": "搜索服务地址列表",
    "hint": "前一个失败自动切换后一个",
    "default": [
      "https://server.codeium.com",
      "https://server.self-serve.windsurf.com"
    ]
  },
  "max_results": {
    "type": "int",
    "description": "搜索返回最大条数",
    "hint": "范围 1-10",
    "default": 5,
    "slider": {
      "min": 1,
      "max": 10,
      "step": 1
    }
  },
  "timeout_seconds": {
    "type": "int",
    "description": "请求超时时间（秒）",
    "default": 20,
    "slider": {
      "min": 5,
      "max": 60,
      "step": 5
    }
  },
  "retryable_status_codes": {
    "type": "list",
    "description": "重试状态码",
    "hint": "默认 429/500/502/503/504；401/403 始终按会话失效处理，200 空结果自动切换下一节点",
    "default": [429, 500, 502, 503, 504]
  },
  "max_retries": {
    "type": "int",
    "description": "重试次数",
    "hint": "默认 3 次；等待时间优先遵守 Retry-After 头，否则指数退避",
    "default": 3,
    "slider": {
      "min": 1,
      "max": 5,
      "step": 1
    }
  },
  "proxy": {
    "type": "string",
    "description": "HTTP 代理地址",
    "hint": "留空不使用代理",
    "default": ""
  },
  "show_sources": {
    "type": "bool",
    "description": "搜索结果中显示来源 URL",
    "default": true
  }
}
